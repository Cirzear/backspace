diff --git a/dist/TwirpRPC.cjs b/dist/TwirpRPC.cjs
index be019086d9ef4b6dc7e9b640ad8f5ac02ac6d830..65ae0b3c719feabb857f9250f69cd82865a007f1 100644
--- a/dist/TwirpRPC.cjs
+++ b/dist/TwirpRPC.cjs
@@ -132,7 +132,10 @@ class TwirpRpc {
       let response;
       let transportError;
       try {
-        response = await fetch(new URL(path, current), init);
+        // Resolve beneath the configured reverse-proxy path, not the origin root.
+        const baseUrl = new URL(current);
+        baseUrl.pathname = `${baseUrl.pathname.replace(/\/$/, "")}/`;
+        response = await fetch(new URL(path.replace(/^\//, ""), baseUrl), init);
       } catch (e) {
         transportError = e;
       }
